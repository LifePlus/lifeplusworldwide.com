---
import random from 'just-random';
import { fetchPublicVacancies, buildVacancySlug } from '../vacancies.mjs';
import { fetchLocales, setCurrentLocale, fetchUploads, getRandomImage } from '../datocms.mjs';
import BaseLayout from '../layouts/BaseLayout.astro';
import TopNav from '../components/TopNav.astro';
import Footer from '../components/Footer.astro';
import Progress from '../components/Progress.astro';
import Container from '../components/Container.vue';
await fetchUploads()

let { vacancy } = Astro.props;
let locale = Astro.props.locale;
setCurrentLocale(locale);

export async function getStaticPaths() {
  const locales = await fetchLocales();
  const publicVacancies = await fetchPublicVacancies();
  const externalVacancies = await fetchPublicVacancies({ visibility: 'external', unfilled: true })

  const vacancyMapper = (vacancy, locale = '') => {
    const prefix = locale === 'en' ? '' : `/${locale}`;
    const applyUrl = `${prefix}/apply/${vacancy.slug}`;

    return {
      params: {
        apply: applyUrl,
      },
      props: {
        vacancy,
        locale: locale || 'en',
      },
    };
  };

  const vacancyPaths = locales.flatMap((locale) => {
    const mappedPublicVacancies = publicVacancies.map((vacancy) => vacancyMapper(vacancy, locale));
    const mappedExternalVacancies = externalVacancies.map((vacancy) => vacancyMapper(vacancy, locale));
    return [...mappedPublicVacancies, ...mappedExternalVacancies];
  });

  const applyPaths = locales.map((locale) => ({
    params: { apply: locale === 'en' ? '/apply' : `/${locale}/apply` },
    props: { vacancy: undefined, locale },
  }));

  return [...applyPaths, ...vacancyPaths];
}

const logos = {
  academy: 'academy.svg',
  cdis: 'cdis.svg',
  isw: 'cdis.svg',
  isq: 'isq.svg',
  tis: 'tis.svg',
  tws: 'tws.svg',
  wyis: 'wyis.svg',
  yhis: 'yhis.svg',
};

const logo = `/assets/logos/${vacancy?.entity?.short_name ? logos[vacancy.entity.short_name.toLowerCase()] || 'lpwl.svg' : 'lpwl.svg'}`;
const utmContent = `${vacancy?.slug || ''} ${locale}`.toLowerCase().replace(/[^a-z0-9]+/g, '+');
const featured = getRandomImage(vacancy?.entity?.short_name?.toLowerCase())
const nameCountry = vacancy ? (vacancy.display + (vacancy.location ? ` ${vacancy.location}` : (vacancy.entity?.country ? ` in ${vacancy.entity.country}` : ''))) : 'LifePlus careers';
const description = vacancy
  ? (vacancy.entity?.name
      ? `Apply for ${nameCountry} at ${vacancy.entity?.name} and LifePlus.`
      : `Apply for ${nameCountry} at LifePlus.`)
  : 'Join the LifePlus team and make a difference in international education.';

const applicationUrlAmerican = vacancy
  ? `https://apply.lifeplusworldwide.com/a/interest?utm_source=lifeplus&utm_content=${encodeURIComponent(utmContent)}&s=1&v=${vacancy.id}`
  : `https://apply.lifeplusworldwide.com/a/interest?utm_source=lifeplus&utm_content=${encodeURIComponent(utmContent)}&s=1`;
const applicationUrlChinese = vacancy
  ? `https://applycn.lifeplusworldwide.com/a/interest?utm_source=lifeplus&utm_content=${encodeURIComponent(utmContent)}&s=1&v=${vacancy.id}`
  : `https://applycn.lifeplusworldwide.com/a/interest?utm_source=lifeplus&utm_content=${encodeURIComponent(utmContent)}&s=1`;

